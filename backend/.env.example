# VoiceShieldAI Environment Configuration Template
# Copy this file to .env and fill in your API credentials.

# Deepfake Audio Detection
REALITY_DEFENDER_API_KEY=

# Speech-to-Text Transcription
ASSEMBLYAI_API_KEY=

# Scam & Conversation Intelligence
GEMINI_API_KEY=
GROQ_API_KEY=

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# Security and lifecycle tuning
MAX_UPLOAD_SIZE_MB=25
CACHE_ENABLED=true
CACHE_TTL_SEC=3600
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
EWMA_ALPHA=0.3
RD_TIMEOUT_MS=25000
ASSEMBLYAI_TIMEOUT_MS=60000
LLM_TIMEOUT_MS=30000
MAX_RETRIES=2
RETRY_DELAY_MS=1000
SPEAKER_MATCH_THRESHOLD=0.70
VAD_THRESHOLD=0.5
VAD_RMS_THRESHOLD=0.015
CHUNK_LENGTH_SEC=30
