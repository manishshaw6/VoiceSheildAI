# VoiceShieldAI Environment Configuration Template
# Copy this file to .env and fill in your API credentials.

# Deepfake Audio Detection
REALITY_DEFENDER_API_KEY=

# Local model inference (Express is the only public API; this address is internal)
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TIMEOUT_MS=120000
ML_INFERENCE_TIMEOUT_SECONDS=120
PRIMARY_STT=faster_whisper
PRIMARY_SPEAKER_PROVIDER=ecapa
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
ENABLE_ASSEMBLYAI_FALLBACK=false
ENABLE_FINGERPRINT_FALLBACK=false

# Sarvam Saaras: Indic and code-mixed speech recognition. Keep the key only in .env.
SARVAM_API_KEY=
ENABLE_SARVAM=true
SARVAM_STT_MODEL=saaras:v4
SARVAM_TIMEOUT_MS=30000
PRIMARY_STT_ROUTING=language_aware
ENGLISH_STT_PROVIDER=faster_whisper
INDIC_STT_PROVIDER=sarvam
ENABLE_FASTER_WHISPER=true
ENABLE_FASTER_WHISPER_FALLBACK=false

# Optional fallback speech-to-text provider
ASSEMBLYAI_API_KEY=

# Scam & Conversation Intelligence
GEMINI_API_KEY=
GROQ_API_KEY=

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# Security and lifecycle tuning
MAX_UPLOAD_SIZE_MB=25
CACHE_ENABLED=true
CACHE_TTL_SEC=3600
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
EWMA_ALPHA=0.3
RD_TIMEOUT_MS=25000
ASSEMBLYAI_TIMEOUT_MS=60000
LLM_TIMEOUT_MS=30000
MAX_RETRIES=2
RETRY_DELAY_MS=1000
SPEAKER_MATCH_THRESHOLD=0.70
VAD_THRESHOLD=0.5
VAD_RMS_THRESHOLD=0.015
CHUNK_LENGTH_SEC=30

# User Authentication & OAuth 2.0 (Google Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# Incremental Mail-Send OAuth 2.0 (Gmail API Send Authorization)
GOOGLE_MAIL_REDIRECT_URI=http://localhost:5000/api/v1/mail/google/callback

# Security & Verification Cryptography
SESSION_SECRET=voxshield-dev-session-secret-change-in-prod-2026
REPORT_SIGNING_SECRET=voxshield-dev-report-signing-key-hmac-sha256
PUBLIC_REPORT_VERIFY_BASE_URL=http://localhost:5173/reports/verify

# Operational System Notifications (SendGrid is used ONLY for system alerts, NEVER user fraud mail)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@voxshield.ai

# Controlled developer test recipient for development/staging validation
DEV_TEST_RECIPIENT=test-fraud-desk@voxshield.local
